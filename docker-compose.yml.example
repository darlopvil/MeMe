services:
  meme:
    build: .
    image: meme:local
    container_name: meme_app
    restart: unless-stopped
    environment:
      - PORT=8003
      # Optional privacy frontends for embedded media
      # - RIMGO_URL=https://rimgo.example.org
      # - PROXITOK_URL=https://proxitok.example.org
      # - NITTER_URL=https://nitter.example.org
      # - INVIDIOUS_URL=https://invidious.example.org
    ports:
      - "8003:8003"
